/*
cbuffer vs_params : register(b0)
{
    row_major float4x4 _17_u_proj : packoffset(c0);
    row_major float4x4 _17_u_view : packoffset(c4);
    row_major float4x4 _17_u_world : packoffset(c8);
};

uniform float4 gl_HalfPixel;

static float4 gl_Position;
static float3 v_nrm;
static float3 a_nrm;
static float2 v_tex;
static float2 a_tex;
static float3 a_pos;
static float4 a_col;
static float4 a_tan;

struct SPIRV_Cross_Input
{
    float3 a_pos : TEXCOORD0;
    float3 a_nrm : TEXCOORD1;
    float2 a_tex : TEXCOORD2;
    float4 a_col : TEXCOORD3;
    float4 a_tan : TEXCOORD4;
};

struct SPIRV_Cross_Output
{
    float3 v_nrm : TEXCOORD0;
    float2 v_tex : TEXCOORD1;
    float4 gl_Position : POSITION;
};

// Returns the determinant of a 2x2 matrix.
float spvDet2x2(float a1, float a2, float b1, float b2)
{
    return a1 * b2 - b1 * a2;
}

// Returns the inverse of a matrix, by using the algorithm of calculating the classical
// adjoint and dividing by the determinant. The contents of the matrix are changed.
float3x3 spvInverse(float3x3 m)
{
    float3x3 adj;	// The adjoint matrix (inverse after dividing by determinant)

    // Create the transpose of the cofactors, as the classical adjoint of the matrix.
    adj[0][0] =  spvDet2x2(m[1][1], m[1][2], m[2][1], m[2][2]);
    adj[0][1] = -spvDet2x2(m[0][1], m[0][2], m[2][1], m[2][2]);
    adj[0][2] =  spvDet2x2(m[0][1], m[0][2], m[1][1], m[1][2]);

    adj[1][0] = -spvDet2x2(m[1][0], m[1][2], m[2][0], m[2][2]);
    adj[1][1] =  spvDet2x2(m[0][0], m[0][2], m[2][0], m[2][2]);
    adj[1][2] = -spvDet2x2(m[0][0], m[0][2], m[1][0], m[1][2]);

    adj[2][0] =  spvDet2x2(m[1][0], m[1][1], m[2][0], m[2][1]);
    adj[2][1] = -spvDet2x2(m[0][0], m[0][1], m[2][0], m[2][1]);
    adj[2][2] =  spvDet2x2(m[0][0], m[0][1], m[1][0], m[1][1]);

    // Calculate the determinant as a combination of the cofactors of the first row.
    float det = (adj[0][0] * m[0][0]) + (adj[0][1] * m[1][0]) + (adj[0][2] * m[2][0]);

    // Divide the classical adjoint matrix by the determinant.
    // If determinant is zero, matrix is not invertable, so leave it unchanged.
    return (det != 0.0f) ? (adj * (1.0f / det)) : m;
}

void vert_main()
{
    v_nrm = mul(spvInverse(float3x3(_17_u_world[0].xyz, _17_u_world[1].xyz, _17_u_world[2].xyz)), a_nrm);
    v_tex = a_tex;
    gl_Position = mul(float4(a_pos, 1.0f), mul(_17_u_world, mul(_17_u_view, _17_u_proj)));
    gl_Position.x = gl_Position.x - gl_HalfPixel.x * gl_Position.w;
    gl_Position.y = gl_Position.y + gl_HalfPixel.y * gl_Position.w;
}

SPIRV_Cross_Output main(SPIRV_Cross_Input stage_input)
{
    a_nrm = stage_input.a_nrm;
    a_tex = stage_input.a_tex;
    a_pos = stage_input.a_pos;
    a_col = stage_input.a_col;
    a_tan = stage_input.a_tan;
    vert_main();
    SPIRV_Cross_Output stage_output;
    stage_output.gl_Position = gl_Position;
    stage_output.v_nrm = v_nrm;
    stage_output.v_tex = v_tex;
    return stage_output;
}
*/
